<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="ClassroomBooking.SupportRequestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сообщить о проблеме" Height="420" Width="560"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Опишите проблему"
                   FontSize="20" FontWeight="Bold"
                   Margin="0,0,0,12" />

        <TextBox x:Name="SubjectTextBox"
                 Grid.Row="1" Height="32"
                 Margin="0,0,0,10"
                 VerticalContentAlignment="Center"
                 ToolTip="Краткая тема обращения" />

        <TextBox x:Name="DescriptionTextBox"
                 Grid.Row="2"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 ToolTip="Что вы делали и что произошло?" />

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Отправить обращение"
                    Width="170" Height="34"
                    Margin="0,0,8,0"
                    Click="SubmitButton_Click" />
            <Button Content="Отмена"
                    Width="90" Height="34"
                    Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>
