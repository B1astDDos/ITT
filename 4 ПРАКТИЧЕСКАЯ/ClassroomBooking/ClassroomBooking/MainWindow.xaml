<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="ClassroomBooking.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Classroom Booking" Height="620" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Бронирование аудитории"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,12" />

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="Пользователь:"
                       VerticalAlignment="Center"
                       Margin="0,0,8,8" />
            <ComboBox x:Name="UserComboBox"
                      Grid.Row="0" Grid.Column="1"
                      Height="26"
                      Margin="0,0,16,8" />

            <TextBlock Grid.Row="0" Grid.Column="2"
                       Text="Аудитория:"
                       VerticalAlignment="Center"
                       Margin="0,0,8,8" />
            <ComboBox x:Name="RoomComboBox"
                      Grid.Row="0" Grid.Column="3"
                      Height="26"
                      Margin="0,0,16,8" />

            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="Дата:"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <DatePicker x:Name="DatePicker"
                        Grid.Row="1" Grid.Column="1"
                        Height="26"
                        Margin="0,0,16,0" />

            <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <TextBlock Text="Время:"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <TextBox x:Name="StartTimeTextBox"
                         Width="60" Height="26"
                         VerticalContentAlignment="Center"
                         TextAlignment="Center" />
                <TextBlock Text="—"
                           VerticalAlignment="Center"
                           Margin="6,0" />
                <TextBox x:Name="EndTimeTextBox"
                         Width="60" Height="26"
                         VerticalContentAlignment="Center"
                         TextAlignment="Center" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,0,0,12">
            <Button x:Name="BookButton"
                    Content="Забронировать"
                    Width="150" Height="34"
                    Margin="0,0,8,0"
                    Click="BookButton_Click" />
            <Button x:Name="SupportButton"
                    Content="Сообщить о проблеме"
                    Width="180" Height="34"
                    Margin="5"
                    Click="SupportButton_Click" />
        </StackPanel>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="StatusTextBlock"
                       Grid.Row="0"
                       Text="Система готова к работе"
                       FontSize="14"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8" />

            <DataGrid x:Name="BookingsGrid"
                      Grid.Row="1"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="№"
                                        Binding="{Binding Id}"
                                        Width="50" />
                    <DataGridTextColumn Header="Дата"
                                        Binding="{Binding DateText}"
                                        Width="110" />
                    <DataGridTextColumn Header="Начало"
                                        Binding="{Binding StartText}"
                                        Width="90" />
                    <DataGridTextColumn Header="Конец"
                                        Binding="{Binding EndText}"
                                        Width="90" />
                    <DataGridTextColumn Header="Пользователь"
                                        Binding="{Binding UserName}"
                                        Width="*" />
                    <DataGridTextColumn Header="Аудитория"
                                        Binding="{Binding RoomName}"
                                        Width="150" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>
