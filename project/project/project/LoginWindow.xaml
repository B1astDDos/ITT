<Window x:Class="project.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация" Height="400" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" 
                   Text="Авторизация" 
                   FontSize="26" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center"/>

        <!-- Поле логина -->
        <TextBlock Grid.Row="2" Text="Логин:" FontSize="14"/>
        <TextBox x:Name="LoginTextBox" 
                 Grid.Row="3" 
                 Height="30" 
                 FontSize="14" 
                 VerticalContentAlignment="Center"/>

        <!-- Поле пароля -->
        <TextBlock Grid.Row="5" Text="Пароль:" FontSize="14"/>
        <PasswordBox x:Name="PasswordInput" 
                     Grid.Row="6" 
                     Height="30" 
                     FontSize="14" 
                     VerticalContentAlignment="Center"/>

        <!-- Сообщение об ошибке (изначально скрыто) -->
        <TextBlock x:Name="ErrorTextBlock" 
                   Grid.Row="8" 
                   Foreground="Red" 
                   FontSize="13" 
                   HorizontalAlignment="Center" 
                   FontWeight="SemiBold"
                   Visibility="Hidden"/>

        <!-- Кнопка Войти -->
        <Button x:Name="LoginButton" 
                Grid.Row="9" 
                Content="Войти" 
                Width="150" 
                Height="40" 
                Margin="0,10,0,0"
                HorizontalAlignment="Center" 
                Click="LoginButton_Click"/>
    </Grid>
</Window>